{
  "schemaVersion": "0.1.0",
  "kind": "template",
  "template": {
    "meta": {
      "title": "MCP 거래명세서"
    },
    "paper": {
      "width": 210,
      "height": 297,
      "padding": [
        15,
        15,
        15,
        15
      ]
    },
    "pages": [
      {
        "elements": [
          {
            "type": "text",
            "id": "title",
            "name": "문서 제목",
            "position": {
              "x": 15,
              "y": 20
            },
            "width": 180,
            "height": 10,
            "content": "거래명세서",
            "fontSize": 18,
            "alignment": "center"
          },
          {
            "type": "field",
            "id": "customer",
            "name": "고객명",
            "position": {
              "x": 15,
              "y": 38
            },
            "width": 100,
            "height": 8,
            "parameter": "customerName"
          },
          {
            "type": "grid",
            "id": "items-table",
            "name": "품목표",
            "position": {
              "x": 15,
              "y": 58
            },
            "columns": [
              {
                "width": 120
              },
              {
                "width": 60
              }
            ],
            "rows": [
              {
                "height": 10
              },
              {
                "height": 10
              },
              {
                "height": 10
              }
            ],
            "cells": [
              {
                "row": 0,
                "column": 0,
                "content": "품명"
              },
              {
                "row": 0,
                "column": 1,
                "content": "금액"
              },
              {
                "row": 1,
                "column": 0,
                "parameter": "name"
              },
              {
                "row": 1,
                "column": 1,
                "parameter": "amount"
              },
              {
                "row": 2,
                "column": 0,
                "content": "합계"
              },
              {
                "row": 2,
                "column": 1,
                "formula": "SUM($(items).$(amount))"
              }
            ],
            "repeat": {
              "parameter": "items",
              "bands": [
                {
                  "id": "items-header",
                  "fromRow": 0,
                  "toRow": 0,
                  "placement": "page-start"
                },
                {
                  "id": "items-item",
                  "fromRow": 1,
                  "toRow": 1,
                  "placement": "item"
                },
                {
                  "id": "items-total",
                  "fromRow": 2,
                  "toRow": 2,
                  "placement": "after-data"
                }
              ],
              "pagination": {
                "mode": "fixed",
                "itemsPerPage": 3
              }
            }
          }
        ]
      }
    ],
    "assets": [],
    "parameters": [
      {
        "key": "customerName",
        "label": "고객명"
      },
      {
        "key": "items",
        "label": "품목",
        "valueType": "list",
        "fields": [
          {
            "key": "name",
            "label": "품명"
          },
          {
            "key": "amount",
            "label": "금액",
            "valueType": "number"
          }
        ]
      }
    ],
    "sampleValues": {
      "customerName": "슬립상사",
      "items": [
        {
          "name": "디자인 작업",
          "amount": 120000
        },
        {
          "name": "PDF 출력",
          "amount": 30000
        }
      ]
    }
  }
}
