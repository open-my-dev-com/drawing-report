{
  "name": "@omdc-slipkit/react",
  "version": "0.0.1",
  "description": "SlipKit React 얇은 래퍼 — @omdc-slipkit/elements의 커스텀 엘리먼트를 React 관례로 노출",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-my-dev-com/drawing-report.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omdc-slipkit/core": "workspace:*",
    "@omdc-slipkit/elements": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.2.8"
  }
}
