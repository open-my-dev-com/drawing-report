{
  "name": "@omdc-slipkit/mcp",
  "version": "0.0.1",
  "description": "Local MCP server for creating and editing .slip forms, assembling vouchers, and rendering PDFs",
  "keywords": [
    "slipkit",
    "slip",
    "form",
    "voucher",
    "pdf",
    "mcp",
    "model-context-protocol",
    "ai"
  ],
  "homepage": "https://github.com/open-my-dev-com/drawing-report#readme",
  "bugs": {
    "url": "https://github.com/open-my-dev-com/drawing-report/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-my-dev-com/drawing-report.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "slipkit-mcp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pdfme/converter": "^6.1.12",
    "@omdc-slipkit/core": "workspace:*",
    "@omdc-slipkit/elements": "workspace:*",
    "zod": "^4.0.0"
  }
}
