{
  "name": "@omdc/slipkit-vue",
  "version": "0.1.2",
  "description": "Vue wrappers for the SlipKit Web Components",
  "keywords": [
    "slipkit",
    "slip",
    "form",
    "voucher",
    "pdf",
    "vue"
  ],
  "homepage": "https://github.com/open-my-dev-com/slipkit#readme",
  "bugs": {
    "url": "https://github.com/open-my-dev-com/slipkit/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-my-dev-com/slipkit.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external vue",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@omdc/slipkit": "workspace:*",
    "@omdc/slipkit-elements": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "vue": "^3.5.0"
  }
}
