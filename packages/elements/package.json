{
  "name": "@omdc-slipkit/elements",
  "version": "0.0.1",
  "description": "SlipKit Web Component UI — <slip-designer>, <slip-viewer> 등 (Lit)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-my-dev-com/drawing-report.git",
    "directory": "packages/elements"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts/pretendard": {
      "types": "./dist/fonts/pretendard.d.ts",
      "import": "./dist/fonts/pretendard.js"
    },
    "./fonts/noto-sans-jp": {
      "types": "./dist/fonts/noto-sans-jp.d.ts",
      "import": "./dist/fonts/noto-sans-jp.js"
    }
  },
  "files": [
    "dist",
    "OFL-Pretendard.txt",
    "OFL-NotoSansJP.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omdc-slipkit/core": "workspace:*",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2"
  }
}
