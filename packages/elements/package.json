{
  "name": "@omdc-slipkit/elements",
  "version": "0.0.1",
  "description": "SlipKit Web Component UI — <slip-designer>, <slip-viewer> 등 (Lit)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts/pretendard": {
      "types": "./dist/fonts/pretendard.d.ts",
      "import": "./dist/fonts/pretendard.js"
    }
  },
  "files": [
    "dist",
    "OFL-Pretendard.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omdc-slipkit/core": "workspace:*",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2"
  }
}
