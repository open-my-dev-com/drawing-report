{
  "name": "@omdc-slipkit/core",
  "version": "0.0.1",
  "description": "SlipKit core — .slip 파일 포맷 스키마·검증·마이그레이션·수식·렌더링 (순수 TS, DOM 비의존)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-my-dev-com/drawing-report.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "generate:schemas": "node scripts/generate-json-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  },
  "dependencies": {
    "@pdfme/common": "^6.1.12",
    "@pdfme/generator": "^6.1.12",
    "@pdfme/schemas": "^6.1.12",
    "fontkit": "^2.0.4",
    "zod": "^4.0.0"
  }
}
