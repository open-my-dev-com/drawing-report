{
  "name": "@omdc-slipkit/core",
  "version": "0.0.1",
  "description": "TypeScript core for validating .slip files, evaluating formulas, assembling vouchers, and generating PDFs",
  "keywords": [
    "slipkit",
    "slip",
    "form",
    "voucher",
    "pdf",
    "schema",
    "formula"
  ],
  "homepage": "https://github.com/open-my-dev-com/drawing-report#readme",
  "bugs": {
    "url": "https://github.com/open-my-dev-com/drawing-report/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-my-dev-com/drawing-report.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "generate:schemas": "node scripts/generate-json-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  },
  "dependencies": {
    "@pdfme/common": "^6.1.12",
    "@pdfme/generator": "^6.1.12",
    "@pdfme/schemas": "^6.1.12",
    "fontkit": "^2.0.4",
    "zod": "^4.0.0"
  }
}
