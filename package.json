{
  "name": "slipkit-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "SlipKit — 임베드형 전표(양식 문서) 패키지 툴 모노레포",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "eslint .",
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "demo": "pnpm --filter slipkit-demo dev",
    "demo:react": "pnpm --filter slipkit-demo-react dev",
    "demo:vue": "pnpm --filter slipkit-demo-vue dev"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
}
